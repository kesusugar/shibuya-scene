# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
/actions-runner/
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/
/qa/*
# ...except the cost benches, which are where the RUN 2 and RUN 3 measurements come from.
!/qa/gta-upgrade/
/qa/gta-upgrade/*
!/qa/gta-upgrade/charbench.html
!/qa/gta-upgrade/vehiclebench.html
!/qa/gta-upgrade/locomotionbench.html

# character pipeline: upstream downloads are verified, never committed
/assets/character/upstream/
